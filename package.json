{
  "name": "react-three-karol",
  "version": "1.0.0",
  "author": "Marco van Meegen",
  "homepage": "https://vanmeegen.github.io/react-three-karol/",
  "scripts": {
    "dev": "vite",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "prettier": "prettier -w src",
    "generate:parser": "antlr-ng -D language=TypeScript --generate-listener false --generate-visitor false -o src/parser/generated antlrgrammar/Karol.g4",
    "deploy": "bun run build && gh-pages -d dist",
    "generate:glb": "cd src/components/modelwrapper && npx gltfjsx --types ../../../public/<insertmyglbname>.glb"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.0",
    "@mui/material": "^9.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "antlr4ng": "^3.0.16",
    "browser-fs-access": "^0.38.0",
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "react": "^19.2.7",
    "react-blockly": "9.0.0",
    "react-dom": "^19.2.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^17.0.23",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@typescript/native-preview": "^7.0.0-dev.20260610.1",
    "@vitejs/plugin-react": "^6.0.2",
    "antlr-ng": "^1.0.10",
    "gh-pages": "^6.3.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
